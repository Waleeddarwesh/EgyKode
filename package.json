{
  "name": "egykode",
  "version": "0.1.0",
  "private": true,
  "description": "EgyKode - the open Cloud & DevOps platform.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "npm run build:id && npm run tokens && npm run topics && npm run search && npm run dev --workspace=@egykode/web",
    "build": "npm run build:id && npm run tokens && npm run topics && npm run search && npm run build --workspace=@egykode/web",
    "start": "npm run start --workspace=@egykode/web",
    "lint": "npm run lint --workspace=@egykode/web",
    "typecheck": "npm run typecheck --workspace=@egykode/web && tsc --noEmit -p tsconfig.json",
    "tokens": "node packages/design-tokens/build.mjs",
    "content:migrate": "python scripts/migrate_handbook.py",
    "content:lint": "node scripts/lint-content.mjs",
    "lint:content-index": "node scripts/build-content-index.mjs --check",
    "desktop:check": "node desktop/scripts/check-package.mjs",
    "desktop:parity": "node desktop/tests/content-parity.mjs",
    "desktop:verify": "npm run desktop:parity && npm run desktop:check",
    "lint:rtl": "node scripts/lint-rtl.mjs",
    "lint:mdx": "python scripts/check_mdx.py",
    "search": "node scripts/build-search-index.mjs",
    "test:e2e": "playwright test --project=desktop tests/e2e/critical-paths.spec.ts",
    "test:visual": "playwright test tests/e2e/visual-matrix.spec.ts",
    "verify": "npm run lint:mdx && npm run lint:diagrams && npm run lint:content-index && npm run content:lint && npm run lint:killercoda && npm run audit:hazards && npm run lint:lab-env && npm run lint:scenarios && npm run lint:refs && npm run lint:resources && npm run lint:rtl && npm run check:translation && npm run test:edge && npm run typecheck && npm run lint && npm run build:verify && npm run test:e2e",
    "topics": "node scripts/build-topics.mjs",
    "audit:topics": "node scripts/audit-topics.mjs",
    "audit:concepts": "node scripts/audit-concepts.mjs",
    "check:translation": "node scripts/check-translation.mjs",
    "test:edge": "node scripts/test-edge-router.mjs",
    "build:verify": "node scripts/build-verify.mjs",
    "lint:diagrams": "node scripts/normalize-diagrams.mjs --check",
    "lint:refs": "node scripts/check-references.mjs",
    "check:live": "node scripts/check-live.mjs",
    "lint:resources": "node scripts/check-resources.mjs",
    "check:links": "node scripts/check-resources.mjs --live",
    "build:id": "node scripts/write-build-id.mjs",
    "doctor": "node scripts/doctor.mjs",
    "lint:killercoda": "node scripts/lint-killercoda.mjs",
    "lab-env:sync": "node scripts/sync-lab-env.mjs .lab-env --write",
    "lint:lab-env": "node scripts/sync-lab-env.mjs .lab-env --check",
    "scenarios:sync": "node scripts/sync-scenarios.mjs .scenarios --write",
    "lint:scenarios": "node scripts/sync-scenarios.mjs .scenarios --check",
    "audit:hazards": "node scripts/audit-scenario-hazards.mjs",
    "test:protocol": "node scripts/test-protocol-handler.mjs",
    "test:sw": "node scripts/test-service-worker.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "axe-core": "^4.13.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
