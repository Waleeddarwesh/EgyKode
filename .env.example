# Overrides for the lab images. You do not need this file.
#
# docker-compose.yml already defaults to the published images, so
# `./egykode start` pulls them. Copy this to `.env` only if you want to run a
# different build — your own fork, or a version other than the current one.
#
#   cp .env.example .env
#
EGYKODE_REPO=waleeddarwesh
EGYKODE_VERSION=1.0
