node_modules/
.next/
out/
dist/
build/
# `build/` matches at any depth, which silently swallowed the Build Tools
# chapter at content/learn/build/ — it was never committed, so CI failed with
# "references unknown chapter build-tools" while the file sat on disk locally.
# The directory itself must be un-ignored; a negation on the file alone does
# not work once its parent is excluded.
!content/learn/build/
.turbo/

# generated
apps/web/styles/tokens.css
apps/web/public/search/
apps/api/db.sqlite3
apps/api/media/
apps/api/staticfiles/

# env
.env
.env.local
.env.*.local
!.env.example

# python
__pycache__/
*.pyc
.venv/
venv/

# os / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*
.next-verify

# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup
tfplan

# NextJS Export
apps/web/.next-export/
.output/
# Screenshots
tests/screenshots/

# Written by scripts/write-build-id.mjs on every build. Committing them would
# mean the repo carries one build's id while the deploy carries another.
apps/web/public/build-id.txt
apps/web/lib/build-id.ts
