node_modules/
.next/
out/
dist/
build/
# `build/` matches at any depth, which silently swallowed the Build Tools
# chapter at content/learn/build/ — it was never committed, so CI failed with
# "references unknown chapter build-tools" while the file sat on disk locally.
# The directory itself must be un-ignored; a negation on the file alone does
# not work once its parent is excluded.
!content/learn/build/
.turbo/

# generated
apps/web/styles/tokens.css
apps/web/public/search/
apps/api/db.sqlite3
apps/api/media/
apps/api/staticfiles/

# env
.env
.env.local
.env.*.local
!.env.example

# python
__pycache__/
*.pyc
.venv/
venv/

# os / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*
.next-verify

# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.backup
tfplan

# NextJS Export
apps/web/.next-export/
.output/
# Screenshots
tests/screenshots/

# Saved page dumps. A rendered Next.js page is one ~1.2MB line of Flight
# payload, which defeats the editor's tokenizer and produces phantom syntax
# errors — t.html was committed this way and reported a fake "';' expected"
# for weeks. Fetch pages into the scratch directory, not the repo root.
/*.html

# Written by scripts/write-build-id.mjs on every build. Committing it would
# mean the repo carries one build's id while the deploy carries another.
apps/web/public/build-id.txt

# TypeScript's incremental cache. It was tracked, so every build rewrote it and
# every commit carried the churn — a machine-local artifact in the diff of
# changes that had nothing to do with it.
*.tsbuildinfo

# Generated mirror of the standalone lab environment repo.
# Built by scripts/sync-lab-env.mjs; lint:lab-env fails when it drifts.
.lab-env/

# Generated mirror of the Killercoda scenarios repo.
# Built by scripts/sync-scenarios.mjs; lint:scenarios fails when it drifts.
.scenarios/
