{
  // Everything at the repository root: the Playwright config and the e2e suite.
  //
  // These files were covered by no tsconfig at all. `npm run typecheck` runs
  // inside apps/web, whose config only includes that workspace, so five
  // TypeScript files — including every end-to-end test — were never checked.
  // The visible symptom was an editor error on `process.env` in
  // playwright.config.ts; the real one was that a type error in the test suite
  // could only ever be found by running it.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["playwright.config.ts", "tests/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "apps", "packages"]
}
